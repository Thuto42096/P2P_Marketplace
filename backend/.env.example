# Port for the chat HTTP + WebSocket server
PORT=4000

# Allowed browser origin(s) for CORS / Socket.IO. Comma-separated.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign JWT session tokens. Override in production.
JWT_SECRET=dev-secret-change-me

# Lifetime of issued JWTs.
JWT_EXPIRES_IN=7d

# SIWE domain expected in signed messages (must match what the frontend uses).
SIWE_DOMAIN=localhost:5173

# SQLite file path (relative to backend/).
DB_PATH=./data/chat.db
